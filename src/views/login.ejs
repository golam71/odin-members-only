<form action="/login" method="POST">
  <div>
    <label for="email">Email Address:</label>
    <input
      type="email"
      id="email"
      name="email"
      placeholder="name@example.com"
      required
    />
  </div>

  <div>
    <label for="password">Password:</label>
    <input
      type="password"
      id="password"
      name="password"
      placeholder="Enter password"
      required
    />
  </div>

  <button type="submit">Sign In</button>
</form>
