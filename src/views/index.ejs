<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

  </head>
  <body>
    <%- include('partials/nav') %>

    <div class="main">
      <!-- <% if (user) { %>
        <p class="greeting">Hello <%= user.full_name %></p>
      <% } %> -->

      <!-- <p>Messages: </p> -->

      <% if (typeof messages !== 'undefined' && messages.length) { %>
        <% messages.forEach((m) => { %>
          <% const canSeeAuthor = user && (user.is_member || user.is_admin); %>
          <div class="message">
            <div class="nameContainer">
              <p class="username"><%= m.title %></p>
              <% if (canSeeAuthor) { %>
                <p class="time"><%= new Date(m.created_at).toLocaleString("en-US", { dateStyle: "medium", timeStyle: "medium" }) %></p>
              <% } %>
            </div>
            <p class="text"><%= m.text %></p>
            <% if (canSeeAuthor) { %>
              <div class="authorContainer">
                <p class="author">By <%= m.author %></p>
                <% if (user.is_admin) { %>
                  <form action="/deleteMessage" method="POST">
                    <input type="hidden" name="message_id" value="<%= m.id %>" />
                    <button type="submit" class="delete">Delete</button>
                  </form>
                <% } %>
              </div>
            <% } %>
          </div>
        <% }) %>
      <% } else { %>
        <p class="empty">No messages yet.</p>
      <% } %>
    </div>

    <%- include('partials/footer') %>
  </body>
</html>