<%- include('partials/nav') %>

<% if (typeof errors !== 'undefined' && errors.length) { %>
  <div class="errors">
    <% errors.forEach((e) => { %><p><%= e %></p><% }) %>
  </div>
<% } %>
<form class="main form" action="/member" method="POST">
  <div>
    <label for="password">Enter Member password:</label>
    <input
      type="password"
      id="password"
      name="password"
      placeholder="Enter password"
      required
    />
  </div>
  <br />
  <button type="submit">Become Member</button>
</form>
<%- include('partials/footer') %>